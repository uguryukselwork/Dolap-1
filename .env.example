# GEMINI_API_KEY: Required for Gemini AI API calls (clothing recognition, outfit suggestions, virtual try-on)
GEMINI_API_KEY="your-gemini-api-key-here"

# SUPABASE CLIENT CONFIG (publicly accessible in frontend)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE SERVER-ONLY CONFIG (used in serverless functions if needed)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

